# GitHub's "Source code (zip)" and "(tar.gz)" downloads on each release are
# built from these rules: they get the extension itself plus README, LICENSE
# and CHANGELOG. Tests, tooling, CI and screenshots stay out of them.
# Clones are unaffected.
/.github         export-ignore
/dev             export-ignore
/docs            export-ignore
/tests           export-ignore
/tools           export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/CONTRIBUTING.md export-ignore
/package.json    export-ignore
